# Protege la configuración (tiene datos de la base de datos) y los archivos internos
<FilesMatch "^(config\.php|.*\.md|.*\.sqlite)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
