# Copia este archivo como ".env" y cambia los valores para activar el conector.
# (El archivo .env no se sube a GitHub.)

# Dónde se guardan las cédulas y respuestas:
#   local     -> en el navegador de cada persona (como está hoy)
#   servidor  -> en la base de datos del juego anterior
VITE_MODO_DATOS=local

# Dirección del programa del servidor que maneja la base de datos.
# Déjala así si la página se instala en el mismo servidor o si se usa el reenvío.
VITE_URL_SERVIDOR=/juego_vial/index.php

# Solo para probar en el computador (npm run dev): servidor real al que se reenvían las consultas.
# Actívalo únicamente con autorización del área de sistemas.
# SERVIDOR_JUEGO_ANTERIOR=https://talentohumano.cootrasana.com.co
